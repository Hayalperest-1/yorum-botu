# Bu dosya sadece YEREL TEST için örnektir. Gerçek değerleri buraya
# yazıp commit ATMA - gerçek değerler GitHub repo secrets'a girecek.
# ".env.example"i kopyala, adını ".env" yap, değerleri doldur.

# Google Business Profile yorum bildirimlerinin geldiği Gmail hesabı
GMAIL_ADDRESS=ornek@gmail.com
# myaccount.google.com/apppasswords adresinden üretilen 16 haneli şifre
# (normal Gmail şifren DEĞİL)
GMAIL_APP_PASSWORD=

# Bu Gmail birden fazla işletmeyi yönetiyorsa, sadece bu ismi İÇEREN
# bildirimleri işle (yoksa hepsi aynı Instagram hesabına düşer)
REVIEW_SOURCE_BUSINESS_NAME=Niğde Gezi Otobüsü

# İşletmenin Google Haritalar linki - Gmail bildirim mailini beklemeden
# doğrudan buradan yeni yorumları okur (opsiyonel, boş bırakılırsa bu
# adım atlanır). Google Haritalar'da işletmeyi aç, "Paylaş" ile linki al.
GOOGLE_MAPS_URL=

IG_ACCESS_TOKEN=
IG_USER_ID=

GITHUB_REPOSITORY=kullanici-adi/repo-adi
